# =====================================================================
# Multimodal AI Personal Assistant Configuration
# Copy this file to .env and customize values for your local environment
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# ---------------------------------------------------------------------
# Standard local Docker Compose PostgreSQL connection:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mmchatbot_db

# ---------------------------------------------------------------------
# AI Provider Configuration
# ---------------------------------------------------------------------
# Options: "openai", "gemini", or "mock" (for offline/zero-cost testing)
AI_PROVIDER=openai

# OpenAI Settings (required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Google Gemini Settings (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---------------------------------------------------------------------
# Embedding & RAG Configuration
# ---------------------------------------------------------------------
# Options: "openai", "gemini", or "mock"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimension (OpenAI text-embedding-3-small: 1536, Gemini text-embedding-004: 768)
EMBEDDING_DIMENSIONS=1536

# RAG Splitting & Retrieval Hyperparameters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.65

# ---------------------------------------------------------------------
# Web Search Configuration
# ---------------------------------------------------------------------
# Options: "tavily", "duckduckgo", or "mock"
SEARCH_PROVIDER=duckduckgo
# Required if SEARCH_PROVIDER=tavily:
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_MAX_RESULTS=5

# ---------------------------------------------------------------------
# Server & Security Configuration
# ---------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads
